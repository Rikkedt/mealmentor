{
  "name": "mealmentor",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "single-page-application" },
  "observability": { "enabled": true },
  // Eget domæne (DNS ligger i Cloudflare). workers.dev virker stadig.
  "routes": [
    { "pattern": "mealmentorai.com/*", "zone_name": "mealmentorai.com" },
    { "pattern": "www.mealmentorai.com/*", "zone_name": "mealmentorai.com" }
  ],
  "workers_dev": true,
  // Push-beskeder: tjekker hvert 5. minut, om der er beskeder, der skal sendes.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Dagligt AI-loft pr. bruger: 40 AI-kald i alt, heraf højst 15 fotoscanninger.
  // Kan ændres med variablerne DAILY_LIMIT og PHOTO_LIMIT.
  "kv_namespaces": [{ "binding": "LIMITS", "id": "33ce0b9df4b54ba0ae9321386dad9d9c" }],
  "vars": { "DAILY_LIMIT": "40", "PHOTO_LIMIT": "15" }
}
