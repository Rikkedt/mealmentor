{
  "name": "mealmentor",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "single-page-application" },
  "observability": { "enabled": true }
  // Valgfrit dagligt AI-loft pr. bruger: opret KV "mealmentor-limits" og tilføj
  // "kv_namespaces": [{ "binding": "LIMITS", "id": "<id>" }]
}
